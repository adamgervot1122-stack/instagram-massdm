# OPPORTUNITY OS — example env. Copy to .env and fill in.

# AI providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Data providers
SEMRUSH_API_KEY=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
APIFY_TOKEN=
BRIGHTDATA_TOKEN=

# Reddit (PRAW)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=opportunity-os/0.1

# Storage
DATABASE_URL=postgres://oos:oos@localhost:5432/oos
REDIS_URL=redis://localhost:6379/0

# Models
PRIMARY_MODEL=claude-opus-4-7
FAST_MODEL=claude-haiku-4-5-20251001

# Cost controls
DAILY_BUDGET_USD=50
CACHE_TTL_HOURS=24

# Web → agents bridge
AGENTS_API_URL=http://localhost:8000
